#!/usr/bin/python3 -I
"""Set or clear the immutable attribute on a game's files for Modular's build lock.

Runs as root through pkexec (polkit action io.modular.build-lock). Must be installed
root-owned, e.g. /usr/lib/modular/modular-lock-helper, mode 0755.

    modular-lock-helper lock|unlock <game-root>    (relative paths on stdin, NUL-separated)

Safety rules, because this runs as root on paths a user supplies:
  * the caller is PKEXEC_UID (or SUDO_UID); without one the helper refuses;
  * <game-root> must be an absolute path to a directory owned by the caller;
  * every path is opened component by component from <game-root> with O_NOFOLLOW, so a
    symlink anywhere (including one swapped in mid-run) can't lead outside the game root;
  * only regular files owned by the caller are touched, through the opened fd;
  * '..' and absolute paths in the list are rejected.
Output: one summary line "changed=N unchanged=N skipped=N", plus "skip <path>: <reason>" lines on stderr.
"""
import array
import fcntl
import os
import stat
import sys

FS_IOC_GETFLAGS = 0x80086601
FS_IOC_SETFLAGS = 0x40086602
FS_IMMUTABLE_FL = 0x00000010


def fail(msg, code=2):
    print(f"modular-lock-helper: {msg}", file=sys.stderr)
    sys.exit(code)


def caller_uid():
    for var in ("PKEXEC_UID", "SUDO_UID"):
        value = os.environ.get(var)
        if value and value.isdigit():
            return int(value)
    fail("must be run through pkexec (or sudo); refusing to guess the calling user")


def open_root(root, uid):
    if not os.path.isabs(root):
        fail("game root must be an absolute path")
    # Walk the root itself without following symlinks in any component.
    fd = os.open("/", os.O_PATH | os.O_DIRECTORY)
    for part in [p for p in root.split("/") if p]:
        nfd = os.open(part, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
        os.close(fd)
        fd = nfd
    if os.fstat(fd).st_uid != uid:
        fail("game root is not owned by the calling user", 3)
    return fd


def open_file(root_fd, rel):
    parts = rel.split("/")
    if rel.startswith("/") or any(p in ("", ".", "..") for p in parts):
        raise ValueError("bad path")
    dfd = os.dup(root_fd)
    try:
        for part in parts[:-1]:
            nfd = os.open(part, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dfd)
            os.close(dfd)
            dfd = nfd
        return os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY, dir_fd=dfd)
    finally:
        os.close(dfd)


def main():
    if len(sys.argv) != 3 or sys.argv[1] not in ("lock", "unlock"):
        fail("usage: modular-lock-helper lock|unlock <game-root>  (paths on stdin, NUL-separated)")
    action, root = sys.argv[1], sys.argv[2]
    uid = caller_uid()
    try:
        root_fd = open_root(root, uid)
    except OSError as e:
        fail(f"can't open game root without following symlinks: {e}", 3)

    data = sys.stdin.buffer.read()
    paths = [p.decode("utf-8", "surrogateescape") for p in data.split(b"\0") if p]
    changed = unchanged = skipped = 0
    for rel in paths:
        try:
            fd = open_file(root_fd, rel)
        except (OSError, ValueError) as e:
            skipped += 1
            print(f"skip {rel}: {e}", file=sys.stderr)
            continue
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != uid:
                skipped += 1
                print(f"skip {rel}: not a regular file owned by the caller", file=sys.stderr)
                continue
            flags = array.array("i", [0])
            fcntl.ioctl(fd, FS_IOC_GETFLAGS, flags, True)
            current = bool(flags[0] & FS_IMMUTABLE_FL)
            want = action == "lock"
            if current == want:
                unchanged += 1
                continue
            flags[0] = (flags[0] | FS_IMMUTABLE_FL) if want else (flags[0] & ~FS_IMMUTABLE_FL)
            fcntl.ioctl(fd, FS_IOC_SETFLAGS, flags, False)
            changed += 1
        except OSError as e:
            skipped += 1
            print(f"skip {rel}: {e}", file=sys.stderr)
        finally:
            os.close(fd)
    print(f"changed={changed} unchanged={unchanged} skipped={skipped}")


if __name__ == "__main__":
    main()

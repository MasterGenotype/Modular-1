# Maintainer: superphenotype
# Modular's build-lock helper: lets Modular lock a pinned game build's files (immutable
# attribute) after polkit admin authentication. Packaged separately from modular-git so
# it can be installed by an administrator on its own (and on immutable /usr systems
# through the system's package path, e.g. `deploytix update <pkg>`).
pkgname=modular-lock-helper
pkgver=1.0.0
pkgrel=1
pkgdesc="Privileged helper for Modular's opt-in game build lock (polkit action io.modular.build-lock)"
arch=('any')
url="https://github.com/MasterGenotype/Modular-1"
license=('unknown')
depends=('python' 'polkit')
source=('modular-lock-helper' 'io.modular.build-lock.policy')
sha256sums=('SKIP' 'SKIP')

package() {
    install -Dm0755 modular-lock-helper "$pkgdir/usr/lib/modular/modular-lock-helper"
    install -Dm0644 io.modular.build-lock.policy "$pkgdir/usr/share/polkit-1/actions/io.modular.build-lock.policy"
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Modular.Switch</RootNamespace>
    <AssemblyName>Modular.Switch</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Archive extraction (already used by Modular.Core) -->
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <!-- Logging abstractions -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\lib\TkSharp\TkSharp\TkSharp.csproj" />
    <ProjectReference Include="..\..\lib\TkSharp\TkSharp.Core\TkSharp.Core.csproj" />
    <ProjectReference Include="..\..\lib\TkSharp\TkSharp.Merging\TkSharp.Merging.csproj" />
    <ProjectReference Include="..\..\lib\TkSharp\TkSharp.Data.Embedded\TkSharp.Data.Embedded.csproj" />
    <ProjectReference Include="..\..\lib\TkSharp\Extensions\TkSharp.Extensions.LibHac\TkSharp.Extensions.LibHac.csproj" />
    <ProjectReference Include="..\Modular.Core\Modular.Core.csproj" />
  </ItemGroup>

</Project>

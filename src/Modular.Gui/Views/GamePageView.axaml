<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Modular.Gui.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Modular.Gui.Views.GamePageView"
             x:DataType="vm:GamePageViewModel">

    <Design.DataContext>
        <vm:GamePageViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="14">
            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <mi:MaterialIcon Kind="ArrowLeft" Width="16" Height="16"/>
                    <TextBlock Text="Games"/>
                </StackPanel>
            </Button>

            <!-- Hero banner with the logo over it, as Steam shows it -->
            <Border CornerRadius="10" ClipToBounds="True" Height="200"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                <Panel>
                    <Image Source="{Binding Hero}" Stretch="UniformToFill" VerticalAlignment="Center"/>
                    <Image Source="{Binding Logo}" MaxHeight="120" MaxWidth="360" Margin="24"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding Game.DisplayName}" Classes="title" Margin="24"
                               VerticalAlignment="Bottom"
                               IsVisible="{Binding Logo, Converter={x:Static ObjectConverters.IsNull}}"/>
                </Panel>
            </Border>

            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Width="150" Height="225" Margin="0,0,16,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                        IsVisible="{Binding Grid, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Image Source="{Binding Grid}" Stretch="UniformToFill"/>
                </Border>
                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Kind}" Classes="eyebrow"/>
                        <TextBlock Text="{Binding Game.DisplayName}" Classes="title"/>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <Grid.Styles>
                                <Style Selector="TextBlock.key">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Setter Property="Margin" Value="0,0,16,6"/>
                                </Style>
                                <Style Selector="TextBlock.val">
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </Grid.Styles>
                            <TextBlock Grid.Row="0" Text="Source" Classes="key"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Game.SourceText}" Classes="val"/>
                            <TextBlock Grid.Row="1" Text="ID" Classes="key"/>
                            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Game.IdText}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="Size" Classes="key"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeText}" Classes="val"/>
                            <TextBlock Grid.Row="3" Text="Status" Classes="key"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Game.StatusText}" Classes="val"/>
                            <TextBlock Grid.Row="4" Text="{Binding LocationLabel}" Classes="key"/>
                            <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Location}" TextWrapping="Wrap"/>
                        </Grid>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Classes="accent" Command="{Binding OpenShortcutCommand}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="Steam" Width="16" Height="16"/>
                                    <TextBlock Text="{Binding ShortcutButtonText}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Versions (Steam games) -->
            <ContentControl Content="{Binding Versions}"
                            IsVisible="{Binding Versions, Converter={x:Static ObjectConverters.IsNotNull}}"/>

            <!-- Installed mods -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="INSTALLED MODS" Classes="eyebrow"/>
                    <TextBlock Text="{Binding ModsSummary}" Classes="caption"/>
                    <TextBlock Text="{Binding DeployBuildText}" Classes="caption"
                               IsVisible="{Binding DeployBuildText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding BuildWarning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding BuildWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <WrapPanel IsEnabled="{Binding !IsWorking}">
                        <Button Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,8"
                                ToolTip.Tip="Look for newer files of these mods on Nexus and mod.io, and install the ones you pick in place">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="Update" Width="16" Height="16"/>
                                <TextBlock Text="Check for updates"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding TakeSnapshotCommand}" Margin="0,0,8,8"
                                ToolTip.Tip="Record this game's installed mods; restore the set later from Backups">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="CameraOutline" Width="16" Height="16"/>
                                <TextBlock Text="Take snapshot"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportModListCommand}" Margin="0,0,8,8"
                                ToolTip.Tip="Save these mods as a list file another Modular can install (exact Nexus files, same order)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="FileExportOutline" Width="16" Height="16"/>
                                <TextBlock Text="Export mod list…"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportModListCommand}" Margin="0,0,8,8"
                                ToolTip.Tip="Install the mods of a .modular-modlist.json file into this game">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="FileImportOutline" Width="16" Height="16"/>
                                <TextBlock Text="Install from mod list…"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding ActionStatus}" Classes="caption" TextWrapping="Wrap"
                               IsVisible="{Binding ActionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <DataGrid ItemsSource="{Binding Mods}" IsVisible="{Binding HasMods}"
                              AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="520"
                              CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="90"/>
                            <DataGridTextColumn Header="Installer" Binding="{Binding Installer}" Width="140"/>
                            <DataGridTextColumn Header="Installed" Binding="{Binding InstalledOn}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

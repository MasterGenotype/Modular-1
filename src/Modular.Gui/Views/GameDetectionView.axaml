<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Modular.Gui.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Modular.Gui.Views.GameDetectionView"
             x:DataType="vm:GameDetectionViewModel">

    <Design.DataContext>
        <vm:GameDetectionViewModel/>
    </Design.DataContext>

    <Panel>
    <ContentControl Content="{Binding ActivePage}" IsVisible="{Binding !ShowList}"/>
    <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowList}">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="{Binding TotalGames, StringFormat='{}{0} game(s) detected'}"
                       VerticalAlignment="Center" Opacity="0.7"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding OpenGameCommand}" CommandParameter="{Binding SelectedGame}"
                        IsEnabled="{Binding SelectedGame, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Open the selected game's page (or double-click a row)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <mi:MaterialIcon Kind="OpenInApp" Width="16" Height="16"/>
                        <TextBlock Text="Open"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddNonSteamGameCommand}"
                        ToolTip.Tip="Pick a program and make a Steam shortcut for it">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                        <TextBlock Text="Add non-Steam game"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ScanGamesCommand}"
                        IsEnabled="{Binding !IsLoading}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <mi:MaterialIcon Kind="Magnify" Width="16" Height="16"/>
                        <TextBlock Text="Scan"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Top" Margin="0,0,0,10"/>

        <!-- Games DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Games}"
                  SelectedItem="{Binding SelectedGame}"
                  DoubleTapped="OnGameDoubleTapped"
                  IsVisible="{Binding !IsLoading}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="100"/>
                <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="90"/>
                <DataGridTextColumn Header="Game" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Install Path" Binding="{Binding InstallPath}" Width="2*"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80"/>
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GameDisplayModel">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="5,0">
                                <Panel>
                                    <mi:MaterialIcon Kind="CheckCircle" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}"
                                                     IsVisible="{Binding IsFullyInstalled}"/>
                                    <mi:MaterialIcon Kind="AlertCircle" Width="14" Height="14" Foreground="{DynamicResource WarningBrush}"
                                                     IsVisible="{Binding !IsFullyInstalled}"/>
                                </Panel>
                                <Panel>
                                    <TextBlock Text="Installed" FontSize="12" IsVisible="{Binding IsFullyInstalled}"/>
                                    <TextBlock Text="Partial" FontSize="12" IsVisible="{Binding !IsFullyInstalled}"/>
                                </Panel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,10,0,0" Opacity="0.7"/>
    </Grid>
    </Panel>
</UserControl>

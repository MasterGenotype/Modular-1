<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Modular.Gui.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Modular.Gui.Views.GameDetectionView"
             x:DataType="vm:GameDetectionViewModel">

    <Design.DataContext>
        <vm:GameDetectionViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.tile">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,14,16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tile Border.cover">
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.tile:pointerover Border.cover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <ContentControl Content="{Binding ActivePage}" IsVisible="{Binding !ShowList}"/>
    <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowList}">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="{Binding TotalGames, StringFormat='{}{0} game(s)'}"
                       VerticalAlignment="Center" Opacity="0.7" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" Text="{Binding FilterText}" Watermark="Filter games" MaxWidth="320"
                     HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding AddNonSteamGameCommand}"
                        ToolTip.Tip="Pick any program (a game Steam doesn't sell, an emulator…) and add it to Steam as a shortcut, with artwork">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <mi:MaterialIcon Kind="Steam" Width="16" Height="16"/>
                        <TextBlock Text="Add a program to Steam…"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ScanGamesCommand}" IsEnabled="{Binding !IsLoading}"
                        ToolTip.Tip="Look for games again">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                        <TextBlock Text="Rescan"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Top" Margin="0,0,0,10"/>

        <!-- Game tiles: cover art; tap one for its page -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsLoading}" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding VisibleGames}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameDisplayModel">
                        <Button Classes="tile" Width="150"
                                Command="{Binding $parent[UserControl].((vm:GameDetectionViewModel)DataContext).OpenGameCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding DisplayName}">
                            <StackPanel Spacing="6">
                                <Border Classes="cover" CornerRadius="8" ClipToBounds="True" Width="150" Height="225"
                                        Background="{DynamicResource SurfaceBrush}">
                                    <Panel>
                                        <StackPanel VerticalAlignment="Center" Margin="10" Spacing="8"
                                                    IsVisible="{Binding !HasCover}">
                                            <mi:MaterialIcon Kind="GamepadVariantOutline" Width="32" Height="32" Opacity="0.4"/>
                                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                    </Panel>
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SourceText}" Classes="caption"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,10,0,0" Opacity="0.7"/>
    </Grid>
    </Panel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Modular.Gui.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Modular.Gui.Views.InstalledModsView"
             x:DataType="vm:InstalledModsViewModel">

    <Design.DataContext>
        <vm:InstalledModsViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="0,0,0,15">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Games}"
                          SelectedItem="{Binding SelectedGame}"
                          IsEnabled="{Binding !IsLoading}"
                          MinWidth="260"
                          ToolTip.Tip="Show the mods installed for one game">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameFilterOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding TotalInstalled, StringFormat='{}{0} installed mod(s)'}"
                           VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
            <Button Grid.Column="2" Command="{Binding ReapplyGameCommand}"
                    IsEnabled="{Binding CanReapply}"
                    Margin="0,0,8,0"
                    ToolTip.Tip="Deploy this game's whole mod installation again, in load order, putting back any missing or changed files">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <mi:MaterialIcon Kind="Restore" Width="16" Height="16"/>
                    <TextBlock Text="Re-apply Mods"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Command="{Binding FetchAllMissingDependenciesCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    Margin="0,0,8,0"
                    ToolTip.Tip="Find and download what the installed mods need and do not have">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <mi:MaterialIcon Kind="PackageDown" Width="16" Height="16"/>
                    <TextBlock Text="Fetch Missing Dependencies"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Command="{Binding RemoveAllCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    Margin="0,0,8,0"
                    ToolTip.Tip="Remove all the mods listed">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <mi:MaterialIcon Kind="DeleteSweep" Width="16" Height="16"/>
                    <TextBlock Text="Remove All"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="5" Command="{Binding RefreshInstalledCommand}"
                    IsEnabled="{Binding !IsLoading}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Top" Margin="0,0,0,10"/>

        <!-- Installed Mods DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Changesets}"
                  IsVisible="{Binding !IsLoading}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Changeset" Binding="{Binding ChangesetId}" Width="120"/>
                <DataGridTextColumn Header="Mod" Binding="{Binding ModId}" Width="*"/>
                <DataGridTextColumn Header="Game" Binding="{Binding Game}" Width="160"/>
                <DataGridTextColumn Header="Target Directory" Binding="{Binding TargetDirectory}" Width="2*"/>
                <DataGridTextColumn Header="Installed" Binding="{Binding CreatedAt}" Width="150"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
                <DataGridTemplateColumn Header="" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ChangesetDisplayModel">
                            <Button Command="{Binding $parent[DataGrid].((vm:InstalledModsViewModel)DataContext).FetchMissingDependenciesCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Find and download what this mod needs and does not have"
                                    Padding="6,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <mi:MaterialIcon Kind="PackageDown" Width="14" Height="14"/>
                                    <TextBlock Text="Dependencies" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ChangesetDisplayModel">
                            <Button Command="{Binding $parent[DataGrid].((vm:InstalledModsViewModel)DataContext).UninstallModCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Uninstall this mod"
                                    Padding="6,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <mi:MaterialIcon Kind="Delete" Width="14" Height="14"/>
                                    <TextBlock Text="Remove" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,15,0,0" Opacity="0.7"/>
    </Grid>
</UserControl>

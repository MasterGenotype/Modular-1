<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Modular.Gui.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Modular.Gui.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <Design.DataContext>
        <vm:LibraryViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Mods Directory:" VerticalAlignment="Center" Opacity="0.7"/>
                <TextBlock Text="{Binding ModsDirectory}" VerticalAlignment="Center" FontFamily="Consolas"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding OpenModsDirectoryCommand}" Margin="0,0,10,0"
                    ToolTip.Tip="Open mods folder">
                <mi:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/>
            </Button>
            <Button Grid.Column="2" Command="{Binding RefreshLibraryCommand}" ToolTip.Tip="Refresh">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Content: the mods directory as a tree, and the selected mod's details -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,3*">
            <!-- Library tree: backend / game / mod, as the folders are laid out -->
            <Border Classes="card" Grid.Column="0" Padding="10" Margin="0,0,10,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="Mods directory" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <!-- Covers the selected mod, or every mod in the selected folder -->
                        <Button Grid.Column="1"
                                Command="{Binding CheckForUpdatesCommand}"
                                ToolTip.Tip="{Binding UpdateCheckTip}"
                                ToolTip.ShowOnDisabled="True"
                                Padding="6,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <mi:MaterialIcon Kind="Update" Width="14" Height="14"/>
                                <TextBlock Text="Check updates" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding ReorganizeModsCommand}"
                                IsEnabled="{Binding !IsReorganizing}"
                                ToolTip.Tip="Move downloads into &lt;backend&gt;/&lt;game&gt;/&lt;mod&gt; folders and rename NexusMods mod folders after the mod"
                                Padding="6,4">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <mi:MaterialIcon Kind="FolderSwap" Width="14" Height="14"/>
                                <TextBlock Text="Re-organize" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TreeView ItemsSource="{Binding LibraryTree}"
                              SelectedItem="{Binding SelectedNode}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:LibraryNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:LibraryNode" ItemsSource="{Binding Children}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <mi:MaterialIcon Kind="Server" Width="16" Height="16" Opacity="0.7"
                                                     IsVisible="{Binding IsBackend}"/>
                                    <mi:MaterialIcon Kind="GamepadVariant" Width="16" Height="16" Opacity="0.7"
                                                     IsVisible="{Binding IsGame}"/>
                                    <mi:MaterialIcon Kind="Shape" Width="16" Height="16" Opacity="0.7"
                                                     IsVisible="{Binding IsCategory}"/>
                                    <mi:MaterialIcon Kind="Folder" Width="16" Height="16" Opacity="0.6"
                                                     IsVisible="{Binding IsMod}"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" ToolTip.Tip="{Binding Name}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Opacity="0.6" Text="{Binding Caption}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Files List / Details -->
            <Border Classes="card" Grid.Column="1" Padding="10">
                <DockPanel>
                    <!-- Mod Info Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"
                                IsVisible="{Binding SelectedMod, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="Files" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SelectedMod.Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Location:" Opacity="0.6" FontSize="11" Margin="0,0,8,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModLocation}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModLocation}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Downloaded:" Opacity="0.6" FontSize="11" Margin="0,0,8,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModDownloadDate}" FontSize="11"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Archives:" Opacity="0.6" FontSize="11" Margin="0,0,8,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModArchiveTypes}" FontSize="11"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:" Opacity="0.6" FontSize="11" Margin="0,0,8,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ModDescription}" FontSize="11" TextWrapping="Wrap" MaxLines="3"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Collection:" Opacity="0.6" FontSize="11" Margin="0,0,8,3"
                                       IsVisible="{Binding ModCollectionName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ModCollectionName}" FontSize="11"
                                       IsVisible="{Binding ModCollectionName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>

                        <Separator Margin="0,8,0,4"/>
                    </StackPanel>

                    <!-- Actions for selected mod -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="5" Margin="0,10,0,0"
                                IsVisible="{Binding SelectedMod, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button Command="{Binding OpenModFolderCommand}" ToolTip.Tip="Open folder" Padding="8">
                            <mi:MaterialIcon Kind="FolderOpen" Width="14" Height="14"/>
                        </Button>
                        <Button Command="{Binding DeleteSelectedModCommand}" ToolTip.Tip="Delete mod" Padding="8">
                            <mi:MaterialIcon Kind="Delete" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>

                    <!-- Directory Tree -->
                    <TreeView ItemsSource="{Binding FileTree}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="Folder" Width="14" Height="14" Opacity="0.6" IsVisible="{Binding IsDirectory}"/>
                                    <mi:MaterialIcon Kind="File" Width="14" Height="14" Opacity="0.4" IsVisible="{Binding !IsDirectory}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,10,0,0" Opacity="0.7"/>
    </Grid>
</UserControl>

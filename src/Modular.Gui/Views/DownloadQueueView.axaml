<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Modular.Gui.ViewModels"
             xmlns:models="using:Modular.Gui.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Modular.Gui.Views.DownloadQueueView"
             x:DataType="vm:DownloadQueueViewModel">

    <Design.DataContext>
        <vm:DownloadQueueViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*">
        <!-- History Statistics -->
        <Border Classes="card" Grid.Row="0" Grid.ColumnSpan="2" Padding="12" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,*,*,*,Auto">
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TotalHistoryDownloads}" Classes="stat" HorizontalAlignment="Center"/>
                    <TextBlock Text="Total Downloads" FontSize="12" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SuccessfulHistoryDownloads}" Classes="stat" 
                               Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Successful" FontSize="12" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding FailedHistoryDownloads}" Classes="stat" 
                               Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Failed" FontSize="12" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TotalBytesDownloadedFormatted}" Classes="stat" HorizontalAlignment="Center"/>
                    <TextBlock Text="Total Size" FontSize="12" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="4" Command="{Binding ResetStatisticsCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="Clear the download history and reset these statistics">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <mi:MaterialIcon Kind="Restore" Width="14" Height="14"/>
                        <TextBlock Text="Reset"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Active Downloads Header -->
        <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto" Margin="0,0,8,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <mi:MaterialIcon Kind="Download" Classes="glyph"/>
                <TextBlock Text="Active Downloads" Classes="h2"/>
                <Border Classes="badge"
                        IsVisible="{Binding QueuedCount}">
                    <TextBlock Text="{Binding QueuedCount}" FontSize="12"/>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding CancelAllCommand}" Content="Cancel All"
                    IsEnabled="{Binding IsDownloading}"/>
        </Grid>

        <!-- Active Downloads List -->
        <Border Classes="card" Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" Padding="10" MinHeight="150" DragDrop.AllowDrop="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ActiveDownloads}" x:Name="ActiveDownloadsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadItemModel">
                            <Border Margin="0,0,0,10" Padding="10,8" Background="{DynamicResource SurfaceRaisedBrush}"
                                    CornerRadius="6"
                                    PointerPressed="OnItemPointerPressed"
                                    Cursor="Hand">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <!-- File name and status -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ModName}" FontSize="12" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="10,0" VerticalAlignment="Center">
                                            <mi:MaterialIcon Kind="DragHorizontalVariant" Width="14" Height="14" Opacity="0.4"
                                                             IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DownloadItemState.Queued}}"
                                                             ToolTip.Tip="Drag to reorder"/>
                                            <TextBlock Text="{Binding State}" Opacity="0.7"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).PauseItemCommand}"
                                                CommandParameter="{Binding}" Padding="5" Background="Transparent"
                                                IsVisible="{Binding CanPause}" ToolTip.Tip="Pause">
                                            <mi:MaterialIcon Kind="Pause" Width="14" Height="14"/>
                                        </Button>
                                        <Button Grid.Column="3" Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).ResumeItemCommand}"
                                                CommandParameter="{Binding}" Padding="5" Background="Transparent"
                                                IsVisible="{Binding CanResume}" ToolTip.Tip="Resume">
                                            <mi:MaterialIcon Kind="Play" Width="14" Height="14"/>
                                        </Button>
                                        <Button Grid.Column="4" Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).RemoveItemCommand}"
                                                CommandParameter="{Binding}" Padding="5" Background="Transparent">
                                            <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>

                                    <!-- Progress bar -->
                                    <ProgressBar Grid.Row="1" Value="{Binding Progress}" Maximum="100"
                                                 Height="8" Margin="0,10,0,5"/>

                                    <!-- Progress details -->
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="12" Opacity="0.7"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="12" Opacity="0.7" Margin="10,0"/>
                                        <TextBlock Grid.Column="2" FontSize="12" Opacity="0.7">
                                            <Run Text="{Binding Progress, StringFormat='{}{0:F1}'}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Completed Downloads Header -->
        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" Margin="8,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <mi:MaterialIcon Kind="CheckCircle" Classes="glyph"/>
                <TextBlock Text="Completed" Classes="h2"/>
                <Border Classes="badge"
                        IsVisible="{Binding CompletedCount}">
                    <TextBlock Text="{Binding CompletedCount}" FontSize="12"/>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding SendAllToInstallerCommand}" Content="Install All"
                    IsEnabled="{Binding CompletedCount}" Margin="0,0,5,0"
                    ToolTip.Tip="Send every completed download to the installer"/>
            <Button Grid.Column="2" Command="{Binding ClearCompletedCommand}" Content="Clear All"/>
        </Grid>

        <!-- Completed Downloads List -->
        <Border Classes="card" Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" Padding="10" MinHeight="150">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding CompletedDownloads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadItemModel">
                            <Border Margin="0,0,0,5" Padding="10,8" Background="{DynamicResource SurfaceRaisedBrush}"
                                    CornerRadius="6">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                    <!-- Status icon -->
                                    <Panel Grid.Column="0" Margin="0,0,15,0">
                                        <mi:MaterialIcon Kind="CheckCircle" Foreground="{DynamicResource SuccessBrush}" Width="24" Height="24"
                                                         IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DownloadItemState.Completed}}"/>
                                        <mi:MaterialIcon Kind="AlertCircle" Foreground="{DynamicResource DangerBrush}" Width="24" Height="24"
                                                         IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DownloadItemState.Failed}}"/>
                                        <mi:MaterialIcon Kind="Cancel" Foreground="{DynamicResource MutedBrush}" Width="24" Height="24"
                                                         IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:DownloadItemState.Cancelled}}"/>
                                    </Panel>

                                    <!-- File info -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ModName}" FontSize="12" Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>

                                    <!-- Remove from list -->
                                    <Button Grid.Column="2" VerticalAlignment="Top"
                                            Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).RemoveItemCommand}"
                                            CommandParameter="{Binding}" Padding="5" Background="Transparent"
                                            ToolTip.Tip="Remove from list (keeps the file)">
                                        <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                    </Button>

                                    <!-- Size and file operations -->
                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto"
                                          Margin="0,8,0,0">
                                        <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="12"
                                                   VerticalAlignment="Center" Opacity="0.7"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                                    IsVisible="{Binding HasFile}">
                                            <Button Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).SendToInstallerCommand}"
                                                    CommandParameter="{Binding}" Padding="8,4"
                                                    ToolTip.Tip="Send to the installer for the selected game">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <mi:MaterialIcon Kind="PackageDown" Width="14" Height="14"/>
                                                    <TextBlock Text="Install" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).OpenContainingFolderCommand}"
                                                    CommandParameter="{Binding}" Padding="6,4"
                                                    ToolTip.Tip="Open containing folder">
                                                <mi:MaterialIcon Kind="FolderOpen" Width="14" Height="14"/>
                                            </Button>
                                            <Button Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).DeleteFileCommand}"
                                                    CommandParameter="{Binding}" Padding="6,4"
                                                    ToolTip.Tip="Delete the downloaded file">
                                                <mi:MaterialIcon Kind="Delete" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

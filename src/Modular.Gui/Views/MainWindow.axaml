<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Modular.Gui.ViewModels"
        xmlns:views="using:Modular.Gui.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mi="using:Material.Icons.Avalonia"
        xmlns:conv="using:Modular.Gui.Converters"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Modular.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Modular - Mod Manager"
        Width="1200" Height="800"
        MinWidth="860" MinHeight="560"
        WindowState="Maximized">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="26" Padding="12,0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,8,0"
                         Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="caption"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center"
                        ToolTip.Tip="NexusMods API requests remaining">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <mi:MaterialIcon Kind="Speedometer" Width="11" Height="11"
                                         Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding RateLimitInfo}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="188,*">
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="8,0">
                    <!-- Brand: four tiles, one still to be slotted in -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="6,16,6,18">
                        <Grid Grid.Column="0" Width="26" Height="26" Margin="0,0,10,0"
                              ColumnDefinitions="*,*" RowDefinitions="*,*" VerticalAlignment="Center">
                            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,1.5,1.5" CornerRadius="3,3,3,1"
                                    Background="{DynamicResource AccentGradientBrush}"/>
                            <Border Grid.Row="0" Grid.Column="1" Margin="1.5,0,0,1.5" CornerRadius="3,3,1,3"
                                    Background="{DynamicResource AccentGradientBrush}" Opacity="0.55"/>
                            <Border Grid.Row="1" Grid.Column="0" Margin="0,1.5,1.5,0" CornerRadius="3,1,3,3"
                                    Background="{DynamicResource AccentGradientBrush}" Opacity="0.8"/>
                            <Rectangle Grid.Row="1" Grid.Column="1" Margin="2,2,0.5,0.5" RadiusX="2" RadiusY="2"
                                       Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                                       StrokeDashArray="2,1.5" Opacity="0.8"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="modular" FontSize="16" FontWeight="Bold" LetterSpacing="-0.4"/>
                            <TextBlock Text="MOD MANAGER" Classes="eyebrow" FontSize="8.5" LetterSpacing="2"/>
                        </StackPanel>
                    </Grid>

                    <!-- Settings pinned to the bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,10">
                        <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="6,0,6,6"/>
                            <Button Classes="nav" Command="{Binding NavigateToCommand}" CommandParameter="Settings"
                                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Settings}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="CogOutline"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="1">
                            <TextBlock Text="SOURCES" Classes="eyebrow" Margin="12,0,0,6"/>
                            <Button Classes="nav" Command="{Binding NavigateToCommand}" CommandParameter="NexusMods"
                                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=NexusMods}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="Web"/>
                                    <TextBlock Text="NexusMods" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Command="{Binding NavigateToCommand}" CommandParameter="GameBanana"
                                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=GameBanana}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="Gamepad"/>
                                    <TextBlock Text="GameBanana" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Command="{Binding NavigateToCommand}" CommandParameter="mod.io"
                                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=mod.io}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="Puzzle"/>
                                    <TextBlock Text="mod.io" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="LIBRARY" Classes="eyebrow" Margin="12,14,0,6"/>
                            <Button Classes="nav" Command="{Binding NavigateToCommand}" CommandParameter="Downloads"
                                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Downloads}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="TrayArrowDown"/>
                                    <TextBlock Text="Downloads" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Command="{Binding NavigateToCommand}" CommandParameter="Library"
                                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Library}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="FolderMultipleOutline"/>
                                    <TextBlock Text="Library" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="MANAGE" Classes="eyebrow" Margin="12,14,0,6"/>
                            <Button Classes="nav" Command="{Binding NavigateToCommand}" CommandParameter="Games"
                                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Games}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="GamepadVariantOutline"/>
                                    <TextBlock Text="Games" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Command="{Binding NavigateToCommand}" CommandParameter="Mod Manager"
                                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Mod Manager}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="PackageVariantClosed"/>
                                    <TextBlock Text="Mod Manager" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Command="{Binding NavigateToCommand}" CommandParameter="Backups"
                                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Backups}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="BackupRestore"/>
                                    <TextBlock Text="Backups" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Canvas -->
            <Panel Grid.Column="1" ClipToBounds="True">
                <!-- Ambient light, purely decorative -->
                <Border Background="{DynamicResource CanvasGlowBrush}" IsHitTestVisible="False"/>
                <Border Background="{DynamicResource CanvasGlow2Brush}" IsHitTestVisible="False"/>

                <DockPanel Margin="20,14,20,12">
                    <!-- Page header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding PageGroup}" Classes="eyebrow"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding SelectedPage}" Classes="title" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding PageCaption}" Classes="caption"
                                               VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                <Border Classes="pill" ToolTip.Tip="Refresh the current view">
                                    <TextBlock Text="Ctrl+R  refresh"/>
                                </Border>
                                <Border Classes="pill" ToolTip.Tip="Download the selected mods">
                                    <TextBlock Text="Ctrl+D  download"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Margin="0,10,0,0" Background="{DynamicResource HairlineBrush}"/>
                    </StackPanel>

                    <Grid>
                        <!-- Configuration warning -->
                        <Border IsVisible="{Binding ShowConfigurationWarning}" Classes="callout" VerticalAlignment="Top">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <mi:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="20" Height="20"
                                                 Foreground="{DynamicResource WarningBrush}"
                                                 VerticalAlignment="Top" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Configuration required" Classes="h2"/>
                                    <TextBlock Text="{Binding ConfigurationError}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Open Settings" Classes="accent" VerticalAlignment="Center"
                                        Command="{Binding NavigateToCommand}" CommandParameter="Settings" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Page content -->
                        <ContentControl IsVisible="{Binding ShowPageContent}" Content="{Binding CurrentViewModel}">
                            <ContentControl.DataTemplates>
                                <DataTemplate DataType="vm:NexusModsViewModel">
                                    <views:NexusModsView/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:GameBananaPanelViewModel">
                                    <views:GameBananaPanelView/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:ModIoPanelViewModel">
                                    <views:ModIoPanelView/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DownloadQueueViewModel">
                                    <views:DownloadQueueView/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:SettingsViewModel">
                                    <views:SettingsView/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:LibraryViewModel">
                                    <views:LibraryView/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:GameDetectionViewModel">
                                    <views:GameDetectionView/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:BackupsViewModel">
                                    <views:BackupsView/>
                                </DataTemplate>
                                <DataTemplate DataType="vm:ModManagerViewModel">
                                    <views:ModManagerView/>
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>

                        <!-- Placeholder for pages without a view model yet -->
                        <Border Classes="card" Padding="40" MinHeight="300">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="ShowPageContent"/>
                                    <Binding Path="CurrentViewModel" Converter="{x:Static ObjectConverters.IsNull}"/>
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                <mi:MaterialIcon Kind="Application" Width="48" Height="48" Opacity="0.3"/>
                                <TextBlock Text="Coming soon" Classes="h2" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedPage, StringFormat='{}{0} view is under development'}"
                                           Classes="caption" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Panel>
        </Grid>
    </DockPanel>
</Window>
